  language: java17
  release: none
  release_github: true
  status: active
  justfile: false
  docs:
    enabled: false
  codecov:
    enabled: true
    token: DvVSkrR8zW
  maven:
    group_id: com.unitvectory
    artifact_id: kubetogoogleidtoken
    javadoc: true
  clip4llm:
    exclude:
      - target
  gitignore:
    - .vscode/
